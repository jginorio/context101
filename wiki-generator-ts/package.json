{
  "name": "context101-wiki-generator-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of the Context101 wiki generator (validation twin of wiki-generator/).",
  "scripts": {
    "build": "tsc && rm -rf dist/prompts && cp -r src/prompts dist/prompts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/xai": "^2.0.0",
    "ai": "^5.0.0",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
