#!/usr/bin/env bash
# Ensure the AWS SDK default chain is populated. Source this file; never print
# key material.
set -euo pipefail

# Prefer the standard names. If a host injected a single alternate pair
# (*_aws_access_key_id / *_aws_secret_access_key), map the first match.
if [[ -z "${AWS_ACCESS_KEY_ID:-}" ]]; then
  while IFS= read -r name; do
    prefix="${name%_aws_access_key_id}"
    id_var="${prefix}_aws_access_key_id"
    secret_var="${prefix}_aws_secret_access_key"
    if [[ -n "${!id_var:-}" && -n "${!secret_var:-}" ]]; then
      export AWS_ACCESS_KEY_ID="${!id_var}"
      export AWS_SECRET_ACCESS_KEY="${!secret_var}"
      break
    fi
  done < <(compgen -e | grep -E '_aws_access_key_id$' || true)
fi

if [[ -z "${AWS_REGION:-}" ]]; then
  if [[ -n "${SES_REGION:-}" ]]; then
    export AWS_REGION="$SES_REGION"
  elif [[ -n "${AWS_DEFAULT_REGION:-}" ]]; then
    export AWS_REGION="$AWS_DEFAULT_REGION"
  fi
fi
