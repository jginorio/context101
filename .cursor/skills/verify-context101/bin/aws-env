#!/usr/bin/env bash
# Map Cloud Agent / local secret names onto the AWS SDK default chain.
# Source this file; never print key material.
set -euo pipefail

if [[ -z "${AWS_ACCESS_KEY_ID:-}" ]]; then
  if [[ -n "${plateapr_aws_access_key_id:-}" ]]; then
    export AWS_ACCESS_KEY_ID="$plateapr_aws_access_key_id"
    export AWS_SECRET_ACCESS_KEY="$plateapr_aws_secret_access_key"
  elif [[ -n "${finditpr_aws_access_key_id:-}" ]]; then
    export AWS_ACCESS_KEY_ID="$finditpr_aws_access_key_id"
    export AWS_SECRET_ACCESS_KEY="$finditpr_aws_secret_access_key"
  fi
fi

if [[ -z "${AWS_REGION:-}" ]]; then
  if [[ -n "${SES_REGION:-}" ]]; then
    export AWS_REGION="$SES_REGION"
  elif [[ -n "${AWS_DEFAULT_REGION:-}" ]]; then
    export AWS_REGION="$AWS_DEFAULT_REGION"
  fi
fi
