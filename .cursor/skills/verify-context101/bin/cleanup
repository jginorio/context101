#!/usr/bin/env bash
# Tear down only what this verification run started. Never kill by process name.
# Leaves evidence under artifacts/ in place.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
BASE="${VERIFY_BASE_URL:-http://localhost:3000}"

# Delete leftover verify/ keys if a run id was recorded.
run_file="${VERIFY_RUN_FILE:-/tmp/verify-context101-run.id}"
if [[ -f "$run_file" ]]; then
  prefix=$(cat "$run_file")
  if [[ "$prefix" == verify/* ]]; then
    "$ROOT/files" delete "$prefix" --folder >/dev/null || true
  fi
  rm -f "$run_file"
fi

# Toolbar New file creates at library root. Record those keys here so cleanup
# can remove them without touching production filenames.
extra_file="${VERIFY_EXTRA_KEYS_FILE:-/tmp/verify-context101-extra-keys}"
if [[ -f "$extra_file" ]]; then
  while IFS= read -r key || [[ -n "$key" ]]; do
    [[ -z "$key" ]] && continue
    "$ROOT/files" delete "$key" >/dev/null || true
  done < "$extra_file"
  rm -f "$extra_file"
fi

pid_file=/tmp/verify-context101-next.pid
if [[ -f "$pid_file" ]]; then
  pid=$(cat "$pid_file")
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    # Only stop the instance we launched. The environment-started next on
    # :3000 is shared — do not kill it.
    kill "$pid" 2>/dev/null || true
    # Child next-server, if still around, shares the same cwd/log.
    sleep 0.3
  fi
  rm -f "$pid_file"
fi

echo "cleanup done (artifacts kept)"
